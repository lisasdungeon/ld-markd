{
  "name": "ld-markd",
  "version": "1.2.0",
  "description": "Lets players see the conditions/effects applied to NPCs and monsters on hover or target, plus a GM Hub for viewing and editing NPC conditions.",
  "type": "module",
  "main": "scripts/main.js",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --coverage",
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "eslint scripts/**/*.js"
  },
  "keywords": [
    "foundry",
    "foundry-vtt",
    "module",
    "v13",
    "v14",
    "system-agnostic",
    "conditions"
  ],
  "author": "Lisa's Dungeon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lisasdungeon/ld-markd.git"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rollup": "^4.20.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {},
    "setupFiles": [
      "<rootDir>/__tests__/helpers/jest.setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/helpers/"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "collectCoverageFrom": [
      "scripts/**/*.js"
    ]
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ]
}
